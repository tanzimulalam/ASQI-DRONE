[Unit]
Description=Drone camera daemon (MJPEG stream on :8090)
Documentation=https://github.com/mtsuissl/mtsuissl-airborne
After=network.target

# Rate limiting lives in [Unit]: systemd ignores these in [Service]
# ("Unknown key name ... ignoring"), which silently disables it.
StartLimitIntervalSec=120
StartLimitBurst=8

[Service]
Type=simple
User=john
Group=john
# /dev/video* is root:video on JetPack.
SupplementaryGroups=video
WorkingDirectory=/home/john/Documents/mtsuissl-airborne
# CAM_* overrides live in the shared env file so the stream can be retuned for
# the link without editing this unit. Falls back to the defaults in
# camera_daemon/settings.py (640x480, 30 fps, quality 80) when unset.
# The leading '-' keeps the service startable if the file is absent.
EnvironmentFile=-/etc/drone/drone.env
ExecStart=/usr/bin/python3 -m camera_daemon
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
